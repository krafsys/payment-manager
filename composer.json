{
    "name": "krafsys/payment-manager",
    "description": "A unified, dependency-free PHP interface for Paystack, Flutterwave, Monnify, Kora, and Bachs payment gateways.",
    "type": "library",
    "license": "MIT",
    "keywords": ["payments", "paystack", "flutterwave", "monnify", "kora", "korapay", "bachs", "nigeria", "gateway"],
    "authors": [
        {
            "name": "Krafsys"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "laravel/framework": "Required only if you use the bundled Laravel service provider and facade."
    },
    "autoload": {
        "psr-4": {
            "Krafsys\\PaymentManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Krafsys\\PaymentManager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Krafsys\\PaymentManager\\Laravel\\PaymentManagerServiceProvider"
            ],
            "aliases": {
                "PaymentManager": "Krafsys\\PaymentManager\\Laravel\\Facades\\PaymentManager"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
